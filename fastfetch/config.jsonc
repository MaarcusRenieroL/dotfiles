{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "macos_small", "color": { "1": "38;2;52;211;153" }, "padding": { "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "38;2;52;211;153", "title": "38;2;52;211;153", "separator": "38;2;75;90;105" } },
  "modules": [
    { "type": "title", "format": "󰓦  {user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "os   " },
    { "type": "host", "key": "host " },
    { "type": "kernel", "key": "kern " },
    { "type": "uptime", "key": "up   " },
    { "type": "shell", "key": "sh   " },
    { "type": "terminal", "key": "term " },
    { "type": "cpu", "key": "cpu  " },
    { "type": "memory", "key": "mem  " },
    { "type": "disk", "key": "disk " },
    { "type": "battery", "key": "batt " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
