#!/bin/bash

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

GAP=16

# transparent floating bar
sketchybar --bar position=top height=32 color=$BAR_BG \
  border_width=0 border_color=$BAR_BORDER \
  corner_radius=0 y_offset=0 margin=0 \
  padding_left=8 padding_right=8 \
  shadow=off blur_radius=0

# defaults
sketchybar --default updates=when_shown \
  icon.font="$FONT:Regular:12.0" icon.color=$MUTED \
  label.font="$FONT:Medium:11.5" label.color=$FG \
  icon.padding_left=3 icon.padding_right=3 \
  label.padding_left=0 label.padding_right=3 \
  padding_left=0 padding_right=0 \
  background.drawing=off

sketchybar --add event yabai_windows

# workspace name pill
sketchybar --add item space_name left \
  --set space_name icon=󰓦 icon.color=$ACCENT icon.font="$FONT:Bold:13.0" \
  icon.padding_left=8 icon.padding_right=5 \
  label.font="$FONT:Bold:11.5" label.color=$FG \
  label.padding_right=8 \
  background.drawing=on background.color=$CARD \
  background.border_width=0 \
  background.corner_radius=6 background.height=24 \
  padding_left=0 padding_right=$GAP \
  script="$PLUGIN_DIR/space_name.sh" \
  --subscribe space_name space_change front_app_switched yabai_windows

# spaces
SPACE_COUNT=$(yabai -m query --spaces 2>/dev/null | jq length 2>/dev/null)
SPACE_COUNT=${SPACE_COUNT:-5}
space_items=()
for i in $(seq 1 "$SPACE_COUNT"); do
  space_items+=("space.$i")
  RIGHT_PAD=$([ "$i" -eq "$SPACE_COUNT" ] && echo "$GAP" || echo "1")
  sketchybar --add item space.$i left \
    --set space.$i icon=$i icon.font="$FONT:Bold:11.5" icon.color=$MUTED \
    icon.padding_left=6 icon.padding_right=6 \
    label.drawing=off \
    background.drawing=off background.corner_radius=5 background.height=18 \
    padding_left=1 padding_right=$RIGHT_PAD \
    click_script="yabai -m space --focus $i" \
    script="$PLUGIN_DIR/space.sh $i" \
    --subscribe space.$i space_change front_app_switched yabai_windows
done

sketchybar --add bracket spaces "${space_items[@]}" \
  --set spaces background.drawing=on background.color=$CARD \
  background.border_width=0 \
  background.corner_radius=6 background.height=24

# active application
sketchybar --add item front_app left \
  --set front_app icon=󰘔 icon.color=$ENMA icon.font="$FONT:Bold:12.0" \
  icon.padding_left=8 icon.padding_right=4 \
  label.font="$FONT:Bold:11.5" label.color=$FG label.max_chars=16 \
  label.padding_right=8 \
  background.drawing=on background.color=$CARD \
  background.border_width=0 \
  background.corner_radius=6 background.height=24 \
  padding_left=0 padding_right=$GAP \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched yabai_windows

# clock, battery, volume and wifi
sketchybar --add item clock right \
  --set clock icon=󰥔 icon.color=$ACCENT_BRIGHT update_freq=10 \
  icon.padding_left=4 icon.padding_right=3 \
  label.padding_right=7 \
  popup.align=right popup.height=24 popup.background.color=$CARD \
  popup.background.border_width=0 \
  popup.background.corner_radius=6 \
  script="$PLUGIN_DIR/clock.sh" click_script="$PLUGIN_DIR/popup.sh clock" \
  --subscribe clock mouse.exited.global
sketchybar --add item clock.date popup.clock --set clock.date label.color=$FG icon.drawing=off
sketchybar --add item clock.week popup.clock --set clock.week label.color=$MUTED icon.drawing=off
sketchybar --add item clock.up popup.clock --set clock.up label.color=$MUTED icon.drawing=off

sketchybar --add item battery right \
  --set battery update_freq=60 script="$PLUGIN_DIR/battery.sh" \
  icon.padding_left=4 icon.padding_right=2 \
  label.padding_right=5 \
  popup.align=right popup.background.color=$CARD popup.background.border_width=0 \
  popup.background.corner_radius=6 \
  click_script="$PLUGIN_DIR/popup.sh battery" \
  --subscribe battery power_source_change system_woke mouse.exited.global
sketchybar --add item battery.time popup.battery --set battery.time label.color=$FG icon.drawing=off
sketchybar --add item battery.cycles popup.battery --set battery.cycles label.color=$MUTED icon.drawing=off

sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  icon.padding_left=4 icon.padding_right=2 \
  label.padding_right=5 \
  --subscribe volume volume_change

sketchybar --add item wifi right \
  --set wifi update_freq=15 script="$PLUGIN_DIR/wifi.sh" \
  icon.padding_left=6 icon.padding_right=3 \
  popup.align=right popup.background.color=$CARD popup.background.border_width=0 \
  popup.background.corner_radius=6 \
  click_script="$PLUGIN_DIR/popup.sh wifi" \
  --subscribe wifi system_woke mouse.exited.global
sketchybar --add item wifi.ip popup.wifi --set wifi.ip label.color=$FG icon.drawing=off
sketchybar --add item wifi.gw popup.wifi --set wifi.gw label.color=$MUTED icon.drawing=off

sketchybar --add bracket system wifi volume battery clock \
  --set system background.drawing=on background.color=$CARD \
  background.border_width=0 \
  background.corner_radius=6 background.height=24

# network, memory, cpu
sketchybar --add item cpu right \
  --set cpu icon=󰻠 icon.color=$GOLD update_freq=3 \
  icon.padding_left=4 icon.padding_right=2 \
  label.padding_right=6 \
  padding_left=$GAP \
  script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item memory right \
  --set memory icon=󰍛 icon.color=$ENMA update_freq=5 \
  icon.padding_left=4 icon.padding_right=2 \
  label.padding_right=5 \
  script="$PLUGIN_DIR/memory.sh"

sketchybar --add item network right \
  --set network update_freq=2 icon=󰛳 icon.color=$ACCENT \
  icon.padding_left=6 icon.padding_right=3 \
  label.padding_right=5 \
  script="$PLUGIN_DIR/network.sh"

sketchybar --add bracket vitals network memory cpu \
  --set vitals background.drawing=on background.color=$CARD \
  background.border_width=0 \
  background.corner_radius=6 background.height=24

sketchybar --update
