#!/bin/bash
# Sketchybar — maarcus.dev look: navy base, hairline borders, emerald accent, mono type.

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar position=top height=34 color=$BG \
                 border_width=1 border_color=$BORDER \
                 padding_left=10 padding_right=10 shadow=off

sketchybar --default updates=when_shown \
                     icon.font="$FONT:Regular:13.0" icon.color=$MUTED \
                     label.font="$FONT:Medium:12.0" label.color=$FG \
                     icon.padding_left=3 icon.padding_right=3 \
                     label.padding_left=0 label.padding_right=4 \
                     padding_left=1 padding_right=1 \
                     background.drawing=off

sketchybar --add event yabai_windows

# --- LEFT: [ workspace name ] [1] [2] [3] [4] [5] [ app name ] -----------------

# 1. Name of the workspace (browsing, ai, coding, dev tools, media)
sketchybar --add item space_name left \
           --set space_name icon=󰖯 icon.color=$ACCENT \
                 icon.padding_left=4 icon.padding_right=6 \
                 label.font="$FONT:Bold:12.0" label.color=$FG \
                 label.padding_right=10 \
                 script="$PLUGIN_DIR/space_name.sh" \
           --subscribe space_name space_change front_app_switched yabai_windows

# 2. Spaces: numbers without names
SPACE_COUNT=$(yabai -m query --spaces 2>/dev/null | jq length 2>/dev/null)
for i in $(seq 1 "${SPACE_COUNT:-5}"); do
  sketchybar --add item space.$i left \
             --set space.$i icon=$i icon.font="$FONT:Bold:12.0" icon.color=$MUTED \
                   icon.padding_left=6 icon.padding_right=6 \
                   label.drawing=off \
                   background.drawing=on background.color=$TRANSPARENT \
                   background.corner_radius=6 background.height=22 \
                   click_script="yabai -m space --focus $i" \
                   script="$PLUGIN_DIR/space.sh $i" \
             --subscribe space.$i space_change front_app_switched yabai_windows
done

# 3. Name of open application
sketchybar --add item front_app left \
           --set front_app icon=󰘔 icon.color=$ACCENT \
                 icon.padding_left=8 icon.padding_right=5 \
                 label.font="$FONT:Bold:12.0" label.color=$FG label.max_chars=18 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched yabai_windows


# --- RIGHT (compact to avoid the MacBook notch) -------------------------------

# 1. Clock (compact: Day + Time)
sketchybar --add item clock right \
           --set clock icon=󰥔 icon.color=$ACCENT update_freq=10 \
                 popup.align=right popup.height=24 popup.background.color=$CARD \
                 popup.background.border_width=1 popup.background.border_color=$BORDER \
                 popup.background.corner_radius=8 \
                 script="$PLUGIN_DIR/clock.sh" click_script="$PLUGIN_DIR/popup.sh clock" \
           --subscribe clock mouse.exited.global
sketchybar --add item clock.date popup.clock --set clock.date label.color=$FG icon.drawing=off
sketchybar --add item clock.week popup.clock --set clock.week label.color=$MUTED icon.drawing=off
sketchybar --add item clock.up popup.clock --set clock.up label.color=$MUTED icon.drawing=off

# 2. Battery
sketchybar --add item battery right \
           --set battery update_freq=60 script="$PLUGIN_DIR/battery.sh" \
                 popup.align=right popup.background.color=$CARD popup.background.border_width=1 \
                 popup.background.border_color=$BORDER popup.background.corner_radius=8 \
                 click_script="$PLUGIN_DIR/popup.sh battery" \
           --subscribe battery power_source_change system_woke mouse.exited.global
sketchybar --add item battery.time popup.battery --set battery.time label.color=$FG icon.drawing=off
sketchybar --add item battery.cycles popup.battery --set battery.cycles label.color=$MUTED icon.drawing=off

# 3. Volume
sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# 4. WiFi
sketchybar --add item wifi right \
           --set wifi update_freq=15 script="$PLUGIN_DIR/wifi.sh" \
                 popup.align=right popup.background.color=$CARD popup.background.border_width=1 \
                 popup.background.border_color=$BORDER popup.background.corner_radius=8 \
                 click_script="$PLUGIN_DIR/popup.sh wifi" \
           --subscribe wifi system_woke mouse.exited.global
sketchybar --add item wifi.ip popup.wifi --set wifi.ip label.color=$FG icon.drawing=off
sketchybar --add item wifi.gw popup.wifi --set wifi.gw label.color=$MUTED icon.drawing=off

# 5. Network Speed
sketchybar --add item network right \
           --set network update_freq=2 script="$PLUGIN_DIR/network.sh"

# 6. Spotify (Compact bar widget + Sleek Horizontal Floating Island Player)
sketchybar --add item spotify right \
           --set spotify icon=󰓇 icon.color=$ACCENT update_freq=3 drawing=off \
                 label.max_chars=18 \
                 popup.horizontal=on popup.height=38 popup.align=center \
                 popup.background.color=$CARD popup.background.border_width=1 \
                 popup.background.border_color=$BORDER popup.background.corner_radius=10 \
                 script="$PLUGIN_DIR/spotify.sh update" \
                 click_script="$PLUGIN_DIR/spotify.sh popup" \
           --subscribe spotify mouse.exited.global

# Album Cover Thumbnail
sketchybar --add item spotify.cover popup.spotify \
           --set spotify.cover icon.drawing=off label.drawing=off \
                 background.drawing=on background.color=$TRANSPARENT \
                 background.image.scale=0.06 background.image.corner_radius=6 \
                 background.height=28 width=28 \
                 padding_left=6 padding_right=6 \
                 click_script="open -a Spotify"

# Track Title + Artist
sketchybar --add item spotify.title popup.spotify \
           --set spotify.title icon.drawing=off \
                 label.font="$FONT:Bold:12.0" label.color=$FG label.max_chars=32 \
                 padding_left=2 padding_right=10 \
                 click_script="open -a Spotify"

# Controls: Previous, Play/Pause, Next (Horizontal row)
sketchybar --add item spotify.prev popup.spotify \
           --set spotify.prev icon=󰒮 icon.color=$FG icon.font="$FONT:Bold:14.0" \
                 label.drawing=off \
                 padding_left=6 padding_right=6 \
                 click_script="$PLUGIN_DIR/spotify.sh prev"

sketchybar --add item spotify.play popup.spotify \
           --set spotify.play icon=󰏤 icon.color=$ACCENT icon.font="$FONT:Bold:16.0" \
                 label.drawing=off \
                 padding_left=6 padding_right=6 \
                 click_script="$PLUGIN_DIR/spotify.sh playpause"

sketchybar --add item spotify.next popup.spotify \
           --set spotify.next icon=󰒭 icon.color=$FG icon.font="$FONT:Bold:14.0" \
                 label.drawing=off \
                 padding_left=6 padding_right=8 \
                 click_script="$PLUGIN_DIR/spotify.sh next"

# 7. Memory
sketchybar --add item memory right \
           --set memory icon=󰍛 update_freq=5 script="$PLUGIN_DIR/memory.sh"

# 8. CPU
sketchybar --add item cpu right \
           --set cpu icon=󰻠 update_freq=3 script="$PLUGIN_DIR/cpu.sh"

sketchybar --update
