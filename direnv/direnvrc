# Shared direnv helpers — `use mise`, `layout pnpm`, `layout jdk 21`
export DIRENV_LOG_FORMAT=$'\033[38;2;140;153;168mdirenv: %s\033[0m'

use_mise() {
  direnv_load mise direnv exec
}

layout_pnpm() {
  PATH_add node_modules/.bin
  [ -f pnpm-lock.yaml ] || log_status "no pnpm-lock.yaml — run pnpm install"
}

layout_jdk() {
  local v="${1:-21}"
  local home
  home=$(/usr/libexec/java_home -v "$v" 2>/dev/null) || { log_error "JDK $v not found"; return 1; }
  export JAVA_HOME="$home"
  PATH_add "$JAVA_HOME/bin"
}
