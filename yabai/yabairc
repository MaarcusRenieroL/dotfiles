#!/usr/bin/env sh

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

yabai -m config top_padding 12
yabai -m config bottom_padding 12
yabai -m config left_padding 12
yabai -m config right_padding 12
yabai -m config window_gap 10
yabai -m config window_shadow on

yabai -m signal --add event=window_created action="yabai -m space --balance"
yabai -m signal --add event=window_destroyed action="yabai -m space --balance"

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Discord$" manage=off
yabai -m rule --add app="^WhatsApp$" manage=off

yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^LocalSend$" manage=off
yabai -m rule --add app="^Urban VPN Desktop$" manage=off

yabai -m rule --add app="^VLC$" manage=off
yabai -m rule --add app="^Spotify$" manage=off
yabai -m rule --add app="^Notion Calendar$" manage=off


# Scratchpad terminal (skhd/scripts/scratchpad.sh): floating and centred
yabai -m rule --add title="^scratchpad$" manage=off sticky=on grid=8:8:1:1:6:6

# Keep sketchybar in sync: rebuild when spaces appear/disappear, refresh on window changes
yabai -m signal --add event=space_created action="sketchybar --reload"
yabai -m signal --add event=space_destroyed action="sketchybar --reload"
yabai -m signal --add event=window_created action="sketchybar --trigger yabai_windows"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger yabai_windows"
yabai -m signal --add event=window_moved action="sketchybar --trigger yabai_windows"
yabai -m signal --add event=window_focused action="sketchybar --trigger yabai_windows"
yabai -m signal --add event=window_title_changed action="sketchybar --trigger yabai_windows"

# New windows land on the space that matches the sketchybar names (sketchybar/spaces.conf)
yabai -m rule --add app="^(Google Chrome|Safari)$" space=1                                  # browsing
yabai -m rule --add app="^(Claude|ChatGPT)$" space=2                                        # ai
yabai -m rule --add app="^(Ghostty|WezTerm|Visual Studio Code|IntelliJ IDEA|WebStorm)$" space=3   # coding
yabai -m rule --add app="^(Firefox|Docker Desktop|Docker|Insomnia|Postman)$" space=4        # devtools
yabai -m rule --add app="^(Spotify|VLC)$" space=5                                           # media
