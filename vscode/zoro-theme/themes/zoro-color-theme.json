  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b7a8a", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#34d399" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#f5a524" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#60a5fa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#2dd4bf" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#e6eaef" } },
    { "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#c5ced8" } },
    { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#f87171" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#8c99a8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#34d399", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#34d399" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f87171" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f87171" } }
  ]
}
